# ─── Database ───────────────────────────────────────────────────────────────
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=ali_support
DB_USER=ali_user
DB_PASSWORD=change_me_db_password

# ─── Backend (FastAPI) ───────────────────────────────────────────────────────
SECRET_KEY=change_me_super_secret_jwt_key_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── WhatsApp Bridge ─────────────────────────────────────────────────────────
BRIDGE_PORT=3001
BRIDGE_SECRET=change_me_bridge_secret
BACKEND_WEBHOOK_URL=http://backend:8000/webhook/whatsapp/incoming

# ─── Backend → Bridge ────────────────────────────────────────────────────────
WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:3001
WHATSAPP_BRIDGE_SECRET=change_me_bridge_secret

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=Ali Support <your_email@gmail.com>

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://ali-support.lightningcloud.my/api
NEXT_PUBLIC_WS_URL=wss://ali-support.lightningcloud.my/api/ws

# ─── Media storage ───────────────────────────────────────────────────────────
MEDIA_BASE_URL=https://ali-support.lightningcloud.my/media
